---
import WaIcon from './WaIcon.astro';
// Ficha lateral fixa das páginas de serviço: CTA e aviso legal da página.
import { DICTS, waLink, type Lang } from '../i18n';
import type { Dict } from '../i18n/pt';
interface Props { lang: Lang; wa: keyof Dict['wa']; disclaimer: string }
const { lang, wa, disclaimer } = Astro.props;
const t = DICTS[lang];
---

<aside class="lg:sticky lg:top-28 lg:self-start">
  <div class="rounded-2xl border border-guilloche bg-branco p-7">
    <p class="text-lg font-bold text-tinta">{t.common.reply24}</p>
    <a href={waLink(lang, wa)} target="_blank" rel="noopener" class="btn btn-wa mt-5 w-full"><WaIcon />{t.common.talk}</a>
    <ul class="check-list mt-5 text-sm text-grafite-suave">
      {t.common.trust.slice(0, 3).map((i) => <li class="!my-2">{i}</li>)}
    </ul>
  </div>
  <p class="mt-5 border-l-2 border-guilloche pl-4 text-sm text-grafite-suave">{disclaimer}</p>
</aside>
