---
// Foto gerada no Gemini (imagens-gemini/ → src/assets/fotos/). Se o arquivo ainda não existir,
// não renderiza nada: a página continua montada sem a foto.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
}
const { name, alt, class: cls = '', sizes = '(min-width: 1024px) 560px, 100vw', loading = 'lazy' } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{png,jpg,jpeg,webp}', { eager: true });
const entry = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === name);
const src = entry?.[1]?.default;
const fallbackEntry = Object.entries(files).find(([path]) => path.includes('escritorio'));
const finalSrc = src || fallbackEntry?.[1]?.default;
---

{
  finalSrc && (
    <Image
      src={finalSrc}
      alt={alt}
      widths={[480, 768, 1024, 1280]}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={loading}
      class={cls}
    />
  )
}

