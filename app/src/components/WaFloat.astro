---
import WaIcon from './WaIcon.astro';
import { DICTS, waLink, type Lang } from '../i18n';
import type { Dict } from '../i18n/pt';
interface Props { lang: Lang; wa?: keyof Dict['wa'] }
const { lang, wa = 'geral' } = Astro.props;
const t = DICTS[lang];
---

<a
  href={waLink(lang, wa)}
  target="_blank"
  rel="noopener"
  aria-label={`${t.nav.cta}. ${t.common.reply24}`}
  title={t.nav.cta}
  class="wa-float fixed right-6 bottom-6 z-30 hidden lg:grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_10px_28px_rgb(0_0_0/0.28)] transition-transform hover:scale-105 lg:h-16 lg:w-16"
>
  <WaIcon class="h-8 w-8 lg:h-9 lg:w-9" />
</a>
