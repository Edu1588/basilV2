---
import Base from '../../layouts/Base.astro';
import HeroDoc from '../../components/HeroDoc.astro';
import BigNumbers from '../../components/BigNumbers.astro';
import AcolhimentoGrid from '../../components/AcolhimentoGrid.astro';
import Foto from '../../components/Foto.astro';
import CtaBand from '../../components/CtaBand.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import WaIcon from '../../components/WaIcon.astro';
import ContactForm from '../../components/ContactForm.tsx';
import { DICTS, SERVICES, WHATSAPP, href, langPaths, waLink, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const h = t.home;
const langIndex = { pt: 0, en: 1, zh: 2 }[lang];
const [main, ...rest] = SERVICES;

const servicePhotos: Record<string, string> = {
  investidor: 'investidor',
  imobiliario: 'imobiliario',
  reuniao: 'reuniao',
  chineses: 'chineses',
  crnm: 'crnm',
  naturalizacao: 'naturalizacao',
  vistoEua: 'vistoEua',
};

---

<Base lang={lang} page="home" title={h.meta.title} description={h.meta.description}>
  <!-- Herói -->
  <section class="guilloche-noite overflow-hidden">
    <div class="wrap grid items-center gap-10 py-12 lg:min-h-[min(calc(100svh-4.5rem),880px)] lg:grid-cols-[1.05fr_1fr] lg:py-8">
      <div>
        <p class="font-medium text-branco/70">{h.hero.kicker}</p>
        <h1 class="hero-title mt-4 max-w-[17ch] text-[clamp(2.3rem,4.8vw,3.9rem)] leading-[1.06]">{h.hero.title}</h1>
        <p class="measure mt-6 text-lg text-branco/80">{h.hero.subtitle}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={waLink(lang, 'geral')} target="_blank" rel="noopener" class="btn btn-wa"><WaIcon />{h.hero.cta}</a>
          <a href="#servicos" class="btn btn-ghost-light">{h.hero.secondary}</a>
        </div>
        <p class="mt-4 text-sm text-branco/70">{h.hero.note}</p>
      </div>
      <div class="flex justify-center lg:justify-end">
        <HeroDoc />
      </div>
    </div>
  </section>

  <!-- Big Numbers: cards flutuantes e painel escuro oficial da BrasilVisa -->
  <BigNumbers lang={lang} />

  <!-- Serviços com fotos acolhedoras e apresentação em grade -->
  <section id="servicos" class="section scroll-mt-20">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-[clamp(1.9rem,3.4vw,2.7rem)] font-display font-bold text-tinta">{h.servicesTitle}</h2>
        <p class="mt-3 text-grafite-suave text-base">Assessoria jurídica completa para investidores, trabalhadores, famílias e expatriados.</p>
      </div>

      <!-- Destaque principal com imagem acolhedora -->
      <a href={href(lang, main)} class="group mt-6 grid gap-6 rounded-3xl bg-tinta text-branco overflow-hidden shadow-xl lg:grid-cols-[1.1fr_0.9fr] items-center" data-reveal>
        <div class="p-8 sm:p-12 space-y-4">
          <span class="inline-block px-3 py-1 rounded-full bg-carmim-vivo text-xs font-bold uppercase tracking-wider text-branco">
            Principal Especialidade
          </span>
          <h3 class="font-display text-2xl font-bold !text-branco md:text-3xl lg:text-4xl leading-tight">
            {t.services[main].label}
          </h3>
          <p class="text-branco/85 text-base leading-relaxed max-w-[50ch]">
            {t.services[main].card}
          </p>
          <div class="pt-2">
            <span class="btn btn-light shrink-0 !min-h-11 !py-2 text-sm font-semibold">{t.common.seeMore}</span>
          </div>
        </div>
        <div class="h-64 sm:h-80 lg:h-full min-h-[260px] overflow-hidden relative">
          <Foto
            name={servicePhotos[main]}
            alt={t.services[main].label}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      </a>

      <!-- Grade dos demais serviços com imagens e visual convidativo -->
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((k) => (
            <li>
              <a href={href(lang, k)} class="group flex h-full flex-col rounded-2xl border border-guilloche bg-branco overflow-hidden shadow-xs hover:shadow-lg hover:border-carmim-vivo transition-all">
                <div class="h-44 overflow-hidden relative bg-papel">
                  <Foto
                    name={servicePhotos[k] || 'escritorio'}
                    alt={t.services[k].label}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-tinta/40 via-transparent to-transparent"></div>
                </div>
                <div class="p-6 flex flex-col flex-1">
                  <span class="font-display text-lg font-bold text-tinta group-hover:text-carmim-vivo transition-colors">{t.services[k].label}</span>
                  <span class="mt-2 text-sm text-grafite-suave leading-relaxed">{t.services[k].card}</span>
                  <span class="mt-auto pt-4 text-xs font-bold uppercase tracking-wider text-carmim-vivo inline-flex items-center gap-1">
                    <span>{t.common.seeMore}</span>
                    <span>→</span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Metodologia e acolhimento humano com os 6 passos e foto familiar -->
  <AcolhimentoGrid lang={lang} />

  <!-- Formulário de triagem -->
  <section id="contato" class="section guilloche scroll-mt-20 !pt-[clamp(56px,7vw,96px)]">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.4fr]">
      <div>
        <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{h.formTitle}</h2>
        <p class="mt-4 text-grafite-suave">{h.formText}</p>
        <a href={href(lang, 'quemSomos')} class="text-link mt-6 inline-block">{t.nav.quemSomos}</a>
      </div>
      <div class="rounded-3xl border border-guilloche bg-branco p-6 md:p-10 shadow-sm">
        <ContactForm
          client:visible
          labels={t.contato.form}
          privacyHref={href(lang, 'privacidade')}
          thanksHref={href(lang, 'obrigado')}
          whatsapp={WHATSAPP}
          defaultLanguage={langIndex}
        />
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={t.services.investidor.cta.title} text={t.services.investidor.cta.text} wa="investidor" />
  <div class="pt-[clamp(72px,10vw,136px)]"><MapEmbed lang={lang} /></div>
</Base>
